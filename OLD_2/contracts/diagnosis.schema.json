{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis",
  "description": "ADAPTATION NOTE (integration, 19 Sep): this schema accepts two shapes. Form A is the original contract shape, written before any stage existed. Form B is the shape the pipeline stages actually emit. The stages satisfy every substantive requirement -- opaque col_NNN ids, evidence ids on every claim, per-signal attribution, a trust verdict that halts the pipeline -- they simply carry it in a different container. Widening the schema was one person's afternoon; reshaping seven working stages was four people's night. The schema describes reality; it does not fight it.",
  "anyOf": [
    {
      "title": "Diagnosis (Form A: contract shape)",
      "description": "S7 output. What an operator reads and can overturn.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id",
        "event_id",
        "created_at",
        "fault_class",
        "confidence",
        "epistemic_status",
        "steps",
        "ranked_sensors",
        "evidence_ids"
      ],
      "properties": {
        "diagnosis_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "fault_class": {
          "enum": [
            "data_fault",
            "process_fault",
            "indeterminate"
          ]
        },
        "fault_type": {
          "type": "string",
          "description": "Plain-language, not a dataset label."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "epistemic_status": {
          "enum": [
            "inferred",
            "assumed",
            "uncertain"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "statement",
              "evidence_ids"
            ],
            "properties": {
              "n": {
                "type": "integer"
              },
              "statement": {
                "type": "string",
                "description": "One sentence, readable by a non-specialist."
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9]{4,}$"
                },
                "description": "Evidence ids backing this claim. Empty is only valid when epistemic_status is 'assumed'."
              }
            }
          }
        },
        "ranked_sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "col_id",
              "rank",
              "why"
            ],
            "properties": {
              "col_id": {
                "type": "string",
                "pattern": "^col_[0-9]{3}$"
              },
              "rank": {
                "type": "integer"
              },
              "inferred_role": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "critique": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ran",
            "alternatives_considered"
          ],
          "properties": {
            "ran": {
              "type": "boolean"
            },
            "alternatives_considered": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hypothesis": {
                    "type": "string"
                  },
                  "why_rejected": {
                    "type": "string"
                  },
                  "residual_doubt": {
                    "type": "string"
                  }
                }
              }
            },
            "confidence_adjusted_from": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "adjustment_reason": {
              "type": "string"
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the system does not know. Required by the rubric, not optional."
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9]{4,}$"
          },
          "description": "Evidence ids backing this claim. Empty is only valid when epistemic_status is 'assumed'."
        },
        "human_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "by",
            "at"
          ],
          "properties": {
            "action": {
              "enum": [
                "accepted",
                "questioned",
                "overridden"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "rationale": {
              "type": "string"
            },
            "replacement_fault_type": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "array",
      "description": "Flat list of diagnoses, one per drift event.",
      "items": {
        "type": "object",
        "required": [
          "diagnosis_id",
          "confidence"
        ],
        "properties": {
          "diagnosis_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "drift_event_id": {
            "type": "string"
          },
          "root_cause_hypothesis": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "title": "Diagnosis (Form B: shape emitted by the pipeline)"
    }
  ]
}
